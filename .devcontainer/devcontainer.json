{
  "name": "Spec-driven delivery",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:5-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    "OPENSPEC_TELEMETRY": "0"
  },
  "updateContentCommand": "npm ci",
  "customizations": {
    "codespaces": {
      "openFiles": ["intent/option-a-record-identification.md"]
    },
    "vscode": {
      "extensions": [
        "GitHub.copilot-chat"
      ]
    }
  }
}
